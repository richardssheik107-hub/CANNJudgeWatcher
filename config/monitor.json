{
  "transport": "http",
  "cli_command": [
    "cannjudge"
  ],
  "cli_auth": false,
  "cookie_env": "CANNJUDGE_COOKIE",
  "poll_seconds": 120,
  "request_gap_seconds": 1,
  "timeout_seconds": 25,
  "page_size": 100,
  "max_ranking_pages": 100,
  "verify_first_page": true,
  "include_ended": true,
  "rule_epoch": "observed-source-score-v1",
  "problem_weights": {},
  "include": [
    {
      "all_title_keywords": [
        "星辰杯"
      ]
    },
    {
      "all_title_keywords": [
        "京津",
        "东北"
      ]
    }
  ],
  "history_pages_per_poll": 2
}
