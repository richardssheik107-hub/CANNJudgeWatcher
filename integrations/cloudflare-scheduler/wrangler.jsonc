{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "cannjudge-workflow-timer",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "secrets": {
    "required": ["GITHUB_DISPATCH_TOKEN"]
  },
  "observability": {
    "enabled": true
  }
}
